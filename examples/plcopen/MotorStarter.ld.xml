<?xml version="1.0" encoding="utf-8"?>
<!--
  Ladder Diagram (KOP / LD) example in the PLCopen TC6 interchange format.

  Rung 1 is a start/stop seal-in circuit:

      |  startButton  |    stopButton    overload
      |=====] [=======+=======]/[=========]/[=======( motor )
      |     motor     |
      |=====] [=======+

  Rung 2 drives a warm-up timer from the motor contact:

      |     motor
      |=====] [=======[ TON  IN, PT := T#5s ]=======( warmedUp )
-->
<project xmlns="http://www.plcopen.org/xml/tc6_0201">
  <fileHeader companyName="plcforge" productName="plcforge examples" productVersion="0.4.0"
              creationDateTime="2026-02-11T09:15:00"/>
  <contentHeader name="MotorStarter">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="MotorStarter" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="startButton">
              <type><BOOL/></type>
              <documentation>Momentary start push button</documentation>
            </variable>
            <variable name="stopButton">
              <type><BOOL/></type>
              <documentation>Normally closed stop push button</documentation>
            </variable>
            <variable name="overload">
              <type><BOOL/></type>
              <documentation>Thermal overload contact</documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="motor">
              <type><BOOL/></type>
              <documentation>Motor contactor</documentation>
            </variable>
            <variable name="warmedUp">
              <type><BOOL/></type>
              <documentation>Set once the motor has run for the warm-up time</documentation>
            </variable>
          </outputVars>
          <localVars>
            <variable name="warmUpTimer">
              <type><derived name="TON"/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <LD>
            <leftPowerRail localId="1">
              <position x="20" y="20"/>
              <connectionPointOut formalParameter=""/>
            </leftPowerRail>

            <contact localId="2" negated="false">
              <position x="60" y="20"/>
              <connectionPointIn><connection refLocalId="1"/></connectionPointIn>
              <connectionPointOut/>
              <variable>startButton</variable>
            </contact>

            <contact localId="3" negated="false">
              <position x="60" y="60"/>
              <connectionPointIn><connection refLocalId="1"/></connectionPointIn>
              <connectionPointOut/>
              <variable>motor</variable>
            </contact>

            <contact localId="4" negated="true">
              <position x="120" y="20"/>
              <connectionPointIn>
                <connection refLocalId="2"/>
                <connection refLocalId="3"/>
              </connectionPointIn>
              <connectionPointOut/>
              <variable>stopButton</variable>
            </contact>

            <contact localId="5" negated="true">
              <position x="180" y="20"/>
              <connectionPointIn><connection refLocalId="4"/></connectionPointIn>
              <connectionPointOut/>
              <variable>overload</variable>
            </contact>

            <coil localId="6" storage="none">
              <position x="240" y="20"/>
              <connectionPointIn><connection refLocalId="5"/></connectionPointIn>
              <variable>motor</variable>
            </coil>

            <contact localId="7" negated="false">
              <position x="60" y="120"/>
              <connectionPointIn><connection refLocalId="1"/></connectionPointIn>
              <connectionPointOut/>
              <variable>motor</variable>
            </contact>

            <inVariable localId="8">
              <position x="60" y="160"/>
              <connectionPointOut/>
              <expression>T#5s</expression>
            </inVariable>

            <block localId="9" typeName="TON" instanceName="warmUpTimer">
              <position x="140" y="120"/>
              <inputVariables>
                <variable formalParameter="IN">
                  <connectionPointIn><connection refLocalId="7"/></connectionPointIn>
                </variable>
                <variable formalParameter="PT">
                  <connectionPointIn><connection refLocalId="8"/></connectionPointIn>
                </variable>
              </inputVariables>
              <inOutVariables/>
              <outputVariables>
                <variable formalParameter="Q"><connectionPointOut/></variable>
                <variable formalParameter="ET"><connectionPointOut/></variable>
              </outputVariables>
            </block>

            <coil localId="10" storage="none">
              <position x="240" y="120"/>
              <connectionPointIn><connection refLocalId="9" formalParameter="Q"/></connectionPointIn>
              <variable>warmedUp</variable>
            </coil>
          </LD>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations/>
  </instances>
</project>
